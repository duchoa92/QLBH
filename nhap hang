<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StockImport - Giao Diện Nhập Hàng Chuyên Nghiệp</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Vue 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://unpkg.com/lucide-vue-next@latest"></script>
    <!-- Font Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0284c7',
                            700: '#0369a1',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #1e293b; }
        ::-webkit-scrollbar-thumb { background: #475569; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748b; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade { animation: fadeIn 0.18s ease-out forwards; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen">

    <div id="app" class="flex flex-col min-h-screen">

        <!-- TOP BAR / HEADER -->
        <header class="bg-slate-900 border-b border-slate-800 px-4 py-2.5 sm:px-6 flex items-center justify-between shrink-0 shadow-md">
            <div class="flex items-center gap-3">
                <div class="h-9 w-9 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400 font-black text-base shadow-inner">
                    📦
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="text-base font-bold text-white tracking-tight">Tạo Phiếu Nhập Hàng</h1>
                        <span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                            POS-IMPORT #2026-009
                        </span>
                    </div>
                    <p class="text-[11px] text-slate-400">Quản lý nhập hàng sản phẩm thường, biến thể, IMEI/Serial & Thuế VAT</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="hidden md:flex items-center gap-4 text-xs bg-slate-950 px-3 py-1.5 rounded-lg border border-slate-800">
                    <div>
                        <span class="text-slate-400">Tổng mặt hàng: </span>
                        <strong class="text-blue-400 font-mono">{{ orderItems.length }}</strong>
                    </div>
                    <div class="border-r border-slate-800 h-4"></div>
                    <div>
                        <span class="text-slate-400">Tổng SL nhập: </span>
                        <strong class="text-emerald-400 font-mono">{{ totalQuantityCount }}</strong>
                    </div>
                    <div class="border-r border-slate-800 h-4"></div>
                    <div>
                        <span class="text-slate-400">Tổng giá trị: </span>
                        <strong class="text-amber-400 font-mono">{{ formatMoney(grandTotal) }}</strong>
                    </div>
                </div>

                <button @click="resetForm" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-lg transition border border-slate-700 flex items-center gap-1.5">
                    🔄 Tạo Mới
                </button>
            </div>
        </header>

        <!-- MAIN LAYOUT -->
        <main class="flex-1 grid grid-cols-1 lg:grid-cols-12 overflow-hidden">

            <!-- LEFT CONTROL PANEL (5 COLS): PARTIES, SEARCH & ITEM CONFIGURATION -->
            <section class="lg:col-span-5 border-r border-slate-800 bg-slate-900/60 p-3 sm:p-4 overflow-y-auto space-y-4 flex flex-col justify-between">
                
                <div class="space-y-4">
                    
                    <!-- 1. PARTY SELECTION & DATE -->
                    <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5 bg-slate-950 p-1 rounded-lg border border-slate-800 text-xs">
                                <button 
                                    @click="partyType = 'supplier'"
                                    :class="['px-3 py-1 font-bold rounded-md transition', partyType === 'supplier' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-white']"
                                >
                                    🚚 Nhà Cung Cấp
                                </button>
                                <button 
                                    @click="partyType = 'customer'"
                                    :class="['px-3 py-1 font-bold rounded-md transition', partyType === 'customer' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-white']"
                                >
                                    👤 Khách Lẻ (Mua lại)
                                </button>
                            </div>

                            <input type="date" v-model="importDate" class="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1 text-xs text-slate-200 outline-none focus:border-blue-500 font-medium">
                        </div>

                        <!-- Supplier Selector -->
                        <div v-if="partyType === 'supplier'" class="space-y-1.5">
                            <div class="relative">
                                <select v-model="selectedSupplierId" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-xs font-semibold text-white outline-none focus:border-blue-500">
                                    <option v-for="s in suppliers" :key="s.id" :value="s.id">
                                        {{ s.name }} — {{ s.phone }} {{ s.debt ? `(Nợ: ${formatMoney(s.debt)})` : '' }}
                                    </option>
                                </select>
                            </div>
                            <div v-if="activeSupplier" class="flex items-center justify-between text-[11px] bg-slate-950/70 px-2.5 py-1.5 rounded-md border border-slate-800/80">
                                <span class="text-slate-400">Địa chỉ: <strong class="text-slate-200">{{ activeSupplier.address }}</strong></span>
                                <span v-if="activeSupplier.debt > 0" class="text-rose-400 font-semibold">Công nợ cũ: {{ formatMoney(activeSupplier.debt) }}</span>
                            </div>
                        </div>

                        <!-- Customer Details (Buying Used Devices) -->
                        <div v-else class="grid grid-cols-2 gap-2">
                            <input type="text" v-model="customerForm.name" placeholder="Họ tên khách hàng *" class="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white outline-none focus:border-blue-500 font-medium">
                            <input type="text" v-model="customerForm.phone" placeholder="Số điện thoại" class="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white outline-none focus:border-blue-500 font-medium">
                            <input type="text" v-model="customerForm.cccd" placeholder="Số CCCD / CMND" class="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white outline-none focus:border-blue-500 font-medium">
                            <input type="text" v-model="customerForm.address" placeholder="Địa chỉ" class="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-white outline-none focus:border-blue-500 font-medium">
                        </div>
                    </div>

                    <!-- 2. SEARCH & SELECT PRODUCT -->
                    <div class="bg-slate-900 border border-slate-800 rounded-xl p-3 space-y-2.5 relative">
                        <div class="flex items-center justify-between text-xs">
                            <label class="font-bold text-slate-200 flex items-center gap-1.5">
                                🔍 Tìm & Chọn Sản Phẩm Nhập
                            </label>
                            <button @click="showNewProductModal = true" class="text-blue-400 hover:text-blue-300 font-semibold text-[11px] flex items-center gap-1">
                                ➕ Tạo SP mới
                            </button>
                        </div>

                        <div class="relative">
                            <input 
                                type="text" 
                                v-model="productSearch" 
                                @focus="showProductDropdown = true"
                                placeholder="Nhập tên sản phẩm, SKU hoặc quét Mã vạch / Barcode..." 
                                class="w-full bg-slate-950 border border-slate-700 focus:border-blue-500 rounded-lg pl-3 pr-20 py-2 text-xs text-white placeholder-slate-500 font-medium outline-none"
                            >
                            <button 
                                @click="triggerFakeScan" 
                                title="Giả lập camera quét mã vạch"
                                class="absolute right-1 top-1/2 -translate-y-1/2 px-2 py-1 bg-blue-600/20 hover:bg-blue-600/40 text-blue-400 border border-blue-500/30 rounded text-[11px] font-semibold transition flex items-center gap-1"
                            >
                                📷 Scan
                            </button>

                            <!-- SEARCH DROPDOWN -->
                            <div v-if="showProductDropdown && filteredProducts.length" class="absolute left-0 right-0 top-full mt-1 bg-slate-900 border border-slate-700 rounded-xl shadow-2xl z-40 max-h-56 overflow-y-auto divide-y divide-slate-800 custom-scrollbar">
                                <div 
                                    v-for="p in filteredProducts" 
                                    :key="p.id" 
                                    @click="selectProductForConfig(p)"
                                    class="p-2.5 hover:bg-slate-800/80 cursor-pointer transition flex items-center justify-between group"
                                >
                                    <div>
                                        <div class="font-bold text-xs text-white group-hover:text-blue-400 transition">{{ p.name }}</div>
                                        <div class="text-[11px] text-slate-400 flex items-center gap-2 mt-0.5">
                                            <span>SKU: <strong class="text-slate-300">{{ p.sku }}</strong></span>
                                            <span>• Tồn: <strong class="text-emerald-400">{{ p.stock }} {{ p.unit }}</strong></span>
                                        </div>
                                    </div>
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider" :class="getTypeBadgeClass(p.type)">
                                        {{ getTypeLabel(p.type) }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. PRODUCT CONFIGURATION PANEL (Pre-Add Controls) -->
                    <div v-if="activeConfigProduct" class="bg-slate-900 border border-blue-500/30 rounded-xl p-3.5 space-y-3 animate-fade shadow-lg">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                            <div>
                                <span class="text-[10px] uppercase font-bold text-blue-400 tracking-wider">Đang cấu hình nhập:</span>
                                <h3 class="text-xs font-extrabold text-white">{{ activeConfigProduct.name }}</h3>
                            </div>
                            <span class="px-2 py-0.5 text-[10px] font-bold rounded" :class="getTypeBadgeClass(activeConfigProduct.type)">
                                {{ getTypeLabel(activeConfigProduct.type) }}
                            </span>
                        </div>

                        <!-- Price & Unit Settings -->
                        <div class="grid grid-cols-2 gap-2.5">
                            <div>
                                <label class="text-[11px] font-semibold text-slate-400 block mb-1">
                                    Giá nhập / {{ activeConfigProduct.unit }} (Đ)
                                </label>
                                <input type="number" v-model.number="configForm.costPrice" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs font-bold text-emerald-400 outline-none focus:border-blue-500">
                            </div>
                            <div>
                                <label class="text-[11px] font-semibold text-slate-400 block mb-1">
                                    Giá bán đề xuất (Đ)
                                </label>
                                <input type="number" v-model.number="configForm.sellPrice" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs font-bold text-blue-400 outline-none focus:border-blue-500">
                            </div>
                        </div>

                        <!-- Unit Conversion (if applicable) -->
                        <div v-if="activeConfigProduct.conversionUnit" class="bg-slate-950 p-2 rounded-lg border border-slate-800 flex items-center justify-between text-xs">
                            <span class="text-slate-400">Đơn vị quy đổi: <strong>1 {{ activeConfigProduct.unit }} = {{ activeConfigProduct.conversionFactor }} {{ activeConfigProduct.conversionUnit }}</strong></span>
                            <div class="flex items-center gap-2">
                                <label class="text-[11px] text-slate-400">Nhập theo:</label>
                                <select v-model="configForm.priceBasis" class="bg-slate-900 border border-slate-700 rounded px-2 py-0.5 text-[11px] font-bold text-slate-200">
                                    <option value="base">{{ activeConfigProduct.unit }} (Cơ sở)</option>
                                    <option value="conversion">{{ activeConfigProduct.conversionUnit }} (Nhập)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Warranty & VAT Settings -->
                        <div class="grid grid-cols-2 gap-2.5 pt-1">
                            <div>
                                <label class="text-[11px] font-semibold text-slate-400 block mb-1">BH Nhà Cung Cấp</label>
                                <div class="flex items-center">
                                    <input type="number" v-model.number="configForm.supplierWarrantyVal" class="w-full bg-slate-950 border border-slate-700 rounded-l-lg px-2 py-1.5 text-xs text-white outline-none">
                                    <select v-model="configForm.supplierWarrantyUnit" class="bg-slate-800 border border-l-0 border-slate-700 rounded-r-lg px-1.5 py-1.5 text-[11px] text-slate-300 font-medium">
                                        <option value="months">Tháng</option>
                                        <option value="days">Ngày</option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label class="text-[11px] font-semibold text-slate-400 block mb-1">BH Khách Hàng</label>
                                <div class="flex items-center">
                                    <input type="number" v-model.number="configForm.customerWarrantyVal" class="w-full bg-slate-950 border border-slate-700 rounded-l-lg px-2 py-1.5 text-xs text-white outline-none">
                                    <select v-model="configForm.customerWarrantyUnit" class="bg-slate-800 border border-l-0 border-slate-700 rounded-r-lg px-1.5 py-1.5 text-[11px] text-slate-300 font-medium">
                                        <option value="months">Tháng</option>
                                        <option value="days">Ngày</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- VAT & Margin Quick Status Bar -->
                        <div class="flex items-center justify-between text-xs bg-slate-950 px-3 py-2 rounded-lg border border-slate-800">
                            <label class="inline-flex items-center gap-1.5 font-medium cursor-pointer">
                                <input type="checkbox" v-model="configForm.hasVat" class="rounded border-slate-700 text-blue-600 focus:ring-0">
                                <span>Tính Thuế VAT ({{ vatRate }}%)</span>
                            </label>
                            <span class="text-slate-400">
                                % Lợi nhuận dự kiến: 
                                <strong :class="profitMarginPercent >= 15 ? 'text-emerald-400' : 'text-amber-400'" class="font-mono font-bold">
                                    {{ profitMarginPercent.toFixed(1) }}%
                                </strong>
                            </span>
                        </div>

                        <!-- SPECIFIC INPUT CONTROLS ACCORDING TO TYPE -->

                        <!-- TYPE 1: SIMPLE PRODUCT -->
                        <div v-if="activeConfigProduct.type === 'simple'" class="space-y-2">
                            <label class="text-xs font-semibold text-slate-300 block">Số Lượng Nhập</label>
                            <div class="flex items-center gap-2">
                                <button @click="configForm.quantity = Math.max(1, configForm.quantity - 1)" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 font-bold text-slate-200">-</button>
                                <input type="number" min="1" v-model.number="configForm.quantity" class="flex-1 bg-slate-950 border border-slate-700 rounded-lg text-center py-1.5 font-bold text-white text-sm outline-none">
                                <button @click="configForm.quantity++" class="w-9 h-9 rounded-lg bg-slate-800 hover:bg-slate-700 font-bold text-slate-200">+</button>
                            </div>
                        </div>

                        <!-- TYPE 2: VARIANT PRODUCT -->
                        <div v-if="activeConfigProduct.type === 'variant'" class="space-y-2">
                            <label class="text-xs font-semibold text-slate-300 block">Chọn Biến Thể Cần Nhập</label>
                            <div class="space-y-1.5 max-h-40 overflow-y-auto pr-1">
                                <div v-for="v in activeConfigProduct.variants" :key="v.id" class="flex items-center justify-between p-2 rounded bg-slate-950 border border-slate-800 text-xs">
                                    <span class="font-semibold text-slate-200">{{ v.name }}</span>
                                    <div class="flex items-center gap-2">
                                        <span class="text-[11px] text-slate-400">SL:</span>
                                        <input type="number" min="0" v-model.number="v.inputQty" class="w-16 bg-slate-900 border border-slate-700 rounded px-2 py-1 text-center font-bold text-white outline-none">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TYPE 3 & 4: IMEI / SERIAL INPUT TOOLBAR -->
                        <div v-if="['imei', 'imei_variant'].includes(activeConfigProduct.type)" class="space-y-2.5">
                            <div class="flex items-center justify-between text-xs">
                                <span class="font-bold text-blue-400">Nhập Mã IMEI / Serial (Mỗi mã 1 dòng)</span>
                                <button @click="simulateBatchImei" class="text-slate-400 hover:text-white text-[11px] underline">⚡ Dán IMEI mẫu</button>
                            </div>

                            <!-- Variant selector if imei_variant -->
                            <div v-if="activeConfigProduct.type === 'imei_variant'" class="flex items-center gap-2">
                                <label class="text-xs text-slate-400 font-semibold shrink-0">Biến thể:</label>
                                <select v-model="configForm.selectedVariantId" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1 text-xs font-semibold text-slate-200 outline-none">
                                    <option v-for="v in activeConfigProduct.variants" :key="v.id" :value="v.id">
                                        {{ v.name }}
                                    </option>
                                </select>
                            </div>

                            <textarea 
                                v-model="configForm.imeiText"
                                rows="3"
                                placeholder="Nhập hoặc dán dải IMEI/Serial (Xuống dòng hoặc phẩy để phân cách)..."
                                class="w-full bg-slate-950 border border-slate-700 focus:border-blue-500 rounded-lg p-2 text-xs font-mono text-emerald-400 outline-none placeholder-slate-600"
                            ></textarea>
                        </div>

                        <!-- Used Device Note -->
                        <div v-if="partyType === 'customer'" class="space-y-1">
                            <input type="text" v-model="configForm.note" placeholder="Ghi chú máy cũ: iCloud, ngoại hình, lỗi nhỏ..." class="w-full bg-slate-950 border border-amber-500/40 rounded-lg px-2.5 py-1.5 text-xs text-amber-300 outline-none placeholder-slate-600">
                        </div>

                        <!-- PUSH TO ORDER BUTTON -->
                        <button 
                            @click="commitItemToOrder"
                            class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-blue-600/30 transition flex items-center justify-center gap-2"
                        >
                            ➕ Thêm Vào Đơn Nhập Hàng
                        </button>
                    </div>
                </div>

                <!-- FOOTER SUMMARY CARDS -->
                <div class="pt-3 border-t border-slate-800 text-xs space-y-2">
                    <div class="flex items-center justify-between text-slate-400">
                        <span>Đơn vị nhận hàng:</span>
                        <strong class="text-white">{{ partyType === 'supplier' ? (activeSupplier ? activeSupplier.name : '—') : (customerForm.name || 'Khách lẻ') }}</strong>
                    </div>
                    <div class="flex items-center justify-between text-slate-400"><span>Ngày lập phiếu:</span><span class="font-mono text-slate-200">{{ importDate }}</span></div>
                </div>

            </section>

            <!-- RIGHT LIVE RECEIPT TABLE & BILLING SUMMARY (7 COLS) -->
            <section class="lg:col-span-7 bg-slate-950 p-3 sm:p-4 flex flex-col justify-between overflow-y-auto">
                
                <div class="space-y-3">
                    
                    <!-- TABLE HEADER TOOLBAR -->
                    <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                        <div class="flex items-center gap-2">
                            <h2 class="text-sm font-bold text-white">Danh Sách Hàng Nhập Trong Phiếu</h2>
                            <span class="px-2 py-0.5 rounded-full text-xs bg-blue-500/20 text-blue-400 font-mono font-bold">
                                {{ orderItems.length }} Mặt hàng
                            </span>
                        </div>

                        <button v-if="orderItems.length" @click="clearOrder" class="text-xs text-rose-400 hover:text-rose-300 font-medium px-2 py-1 rounded hover:bg-rose-500/10 transition">
                            🗑️ Xóa tất cả
                        </button>
                    </div>

                    <!-- LIVE RECEIPT TABLE -->
                    <div class="border border-slate-800/80 rounded-xl overflow-hidden bg-slate-900/40">
                        <div class="overflow-x-auto max-h-[52vh] custom-scrollbar">
                            <table v-if="orderItems.length" class="w-full text-left text-xs text-slate-300 border-collapse">
                                <thead class="bg-slate-900 text-slate-400 font-semibold sticky top-0 border-b border-slate-800 z-10">
                                    <tr>
                                        <th class="p-2.5">Sản Phẩm & Biến Thể</th>
                                        <th class="p-2.5 text-center w-20">SL</th>
                                        <th class="p-2.5 text-right w-28">Giá Nhập (Đ)</th>
                                        <th class="p-2.5 text-right w-28">Giá Bán (Đ)</th>
                                        <th class="p-2.5 text-right w-32">Thành Tiền (Đ)</th>
                                        <th class="p-2.5 text-center w-12"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800/60 font-medium">
                                    <tr v-for="(item, idx) in orderItems" :key="item.id" class="hover:bg-slate-800/40 transition">
                                        <td class="p-2.5">
                                            <div class="font-bold text-white">{{ item.name }}</div>
                                            <div class="flex flex-wrap items-center gap-1.5 mt-1">
                                                <span v-if="item.hasVat" class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">VAT</span>
                                                <span v-if="item.supplierWarrantyVal" class="px-1.5 py-0.5 rounded text-[10px] bg-slate-800 text-slate-400">BH NCC: {{ item.supplierWarrantyVal }}T</span>
                                                <button v-if="item.imeis && item.imeis.length" @click="openImeiDetailModal(item)" class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-500/20 text-blue-300 border border-blue-500/30 hover:bg-blue-500/30">
                                                    📱 {{ item.imeis.length }} IMEI / Serial ➔
                                                </button>
                                                <button v-if="item.variantRows && item.variantRows.length" @click="openVariantDetailModal(item)" class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30 hover:bg-purple-500/30">
                                                    🎨 {{ item.variantRows.length }} Biến thể ➔
                                                </button>
                                            </div>
                                        </td>
                                        <td class="p-2.5 text-center font-bold">
                                            <input v-if="!item.imeis?.length && !item.variantRows?.length" type="number" min="1" v-model.number="item.quantity" class="w-14 bg-slate-950 border border-slate-700 rounded px-1.5 py-1 text-center font-bold text-white outline-none">
                                            <span v-else class="font-mono text-slate-300">{{ item.quantity }}</span>
                                        </td>
                                        <td class="p-2.5 text-right">
                                            <input type="number" v-model.number="item.costPrice" class="w-24 bg-slate-950 border border-slate-700 rounded px-1.5 py-1 text-right font-bold text-emerald-400 outline-none">
                                        </td>
                                        <td class="p-2.5 text-right">
                                            <input type="number" v-model.number="item.sellPrice" class="w-24 bg-slate-950 border border-slate-700 rounded px-1.5 py-1 text-right font-bold text-blue-400 outline-none">
                                        </td>
                                        <td class="p-2.5 text-right font-mono font-extrabold text-white">
                                            {{ formatMoney(item.costPrice * item.quantity) }}
                                        </td>
                                        <td class="p-2.5 text-center">
                                            <button @click="removeOrderItem(idx)" class="text-slate-500 hover:text-rose-400 p-1 rounded transition">❌</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div v-else class="h-60 flex flex-col items-center justify-center text-center p-6 text-slate-500 space-y-2">
                                <div class="text-3xl">🛒</div>
                                <div class="font-bold text-slate-400 text-sm">Chưa có sản phẩm nào trong phiếu</div>
                                <p class="text-xs text-slate-600 max-w-xs">Chọn sản phẩm ở cột bên trái và bấm "Thêm Vào Đơn Nhập Hàng".</p>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- BILLING SUMMARY & PAYMENT CONTROLS -->
                <div class="mt-4 pt-3 border-t border-slate-800 space-y-3">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <!-- Left Summary Adjustments -->
                        <div class="space-y-2 text-xs bg-slate-900/60 p-3 rounded-xl border border-slate-800">
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Chiết khấu / Giảm giá (Đ):</span>
                                <input type="number" v-model.number="discount" class="w-28 bg-slate-950 border border-slate-700 rounded px-2 py-1 text-right font-bold text-rose-400 outline-none">
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">Phí vận chuyển / Khác (Đ):</span>
                                <input type="number" v-model.number="extraFee" class="w-28 bg-slate-950 border border-slate-700 rounded px-2 py-1 text-right font-bold text-slate-200 outline-none">
                            </div>
                            <div v-if="partyType === 'supplier' && activeSupplier?.debt > 0" class="flex items-center justify-between pt-1 border-t border-slate-800">
                                <label class="inline-flex items-center gap-1.5 text-amber-400 font-semibold cursor-pointer">
                                    <input type="checkbox" v-model="payOldDebt" class="rounded border-slate-700 text-amber-500">
                                    <span>Cộng gộp trả nợ cũ:</span>
                                </label>
                                <span class="font-bold text-rose-400 font-mono">{{ formatMoney(activeSupplier.debt) }}</span>
                            </div>
                        </div>

                        <!-- Right Total Calculations -->
                        <div class="space-y-1.5 text-xs bg-slate-900/90 p-3 rounded-xl border border-slate-800">
                            <div class="flex justify-between text-slate-400"><span>Tiền hàng:</span><strong class="text-slate-200 font-mono">{{ formatMoney(subTotalCost) }}</strong></div>
                            <div class="flex justify-between text-slate-400"><span>Thuế VAT dự kiến:</span><strong class="text-amber-400 font-mono">{{ formatMoney(totalVatEstimate) }}</strong></div>
                            <div class="flex justify-between text-base border-t border-slate-800 pt-1.5">
                                <span class="font-bold text-white">TỔNG THANH TOÁN:</span>
                                <strong class="font-extrabold text-emerald-400 font-mono text-lg">{{ formatMoney(grandTotal) }}</strong>
                            </div>
                        </div>
                    </div>

                    <!-- PAYMENT METHOD & FINAL ACTION BUTTONS -->
                    <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                        <!-- Payment Method Toggle -->
                        <div class="flex items-center gap-1.5 bg-slate-900 p-1 rounded-xl border border-slate-800 text-xs">
                            <button @click="paymentMethod = 'cash'" :class="['px-3 py-1.5 font-bold rounded-lg transition', paymentMethod === 'cash' ? 'bg-blue-600 text-white' : 'text-slate-400']">💵 Tiền Mặt</button>
                            <button @click="paymentMethod = 'bank'" :class="['px-3 py-1.5 font-bold rounded-lg transition', paymentMethod === 'bank' ? 'bg-blue-600 text-white' : 'text-slate-400']">🏦 Chuyển Khoản QR</button>
                            <button @click="paymentMethod = 'card'" :class="['px-3 py-1.5 font-bold rounded-lg transition', paymentMethod === 'card' ? 'bg-blue-600 text-white' : 'text-slate-400']">💳 Thẻ/POS</button>
                        </div>

                        <div class="flex items-center gap-2">
                            <button @click="completeOrder" :disabled="!orderItems.length" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 text-white font-extrabold text-xs rounded-xl shadow-lg shadow-emerald-600/30 transition flex items-center gap-2">
                                ✅ Hoàn Tất & Lưu Phiếu Nhập
                            </button>
                        </div>
                    </div>

                </div>

            </section>

        </main>

        <!-- MODAL: ADD NEW PRODUCT QUICKLY -->
        <div v-if="showNewProductModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-5 space-y-4 shadow-2xl animate-fade">
                <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                    <h3 class="text-sm font-bold text-white">➕ Tạo Sản Phẩm Mới Để Nhập</h3>
                    <button @click="showNewProductModal = false" class="text-slate-500 hover:text-white">✕</button>
                </div>
                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block text-slate-400 mb-1 font-semibold">Tên sản phẩm *</label>
                        <input type="text" v-model="newProductForm.name" placeholder="Ví dụ: Tai nghe Bluetooth Sony..." class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-white font-medium outline-none">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-slate-400 mb-1 font-semibold">Mã SKU</label>
                            <input type="text" v-model="newProductForm.sku" placeholder="SKU-AUTO..." class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-white font-mono outline-none">
                        </div>
                        <div>
                            <label class="block text-slate-400 mb-1 font-semibold">Đơn vị tính</label>
                            <input type="text" v-model="newProductForm.unit" placeholder="Cái / Hộp..." class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-white outline-none">
                        </div>
                    </div>
                    <div>
                        <label class="block text-slate-400 mb-1 font-semibold">Phân loại sản phẩm</label>
                        <select v-model="newProductForm.type" class="w-full bg-slate-950 border border-slate-700 rounded-lg p-2 text-white font-medium outline-none">
                            <option value="simple">📦 Sản phẩm Thường</option>
                            <option value="variant">🎨 Sản phẩm Có Biến Thể</option>
                            <option value="imei">📱 Quản lý IMEI / Serial</option>
                            <option value="imei_variant">⚡ IMEI + Có Biến Thể</option>
                        </select>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-2 pt-2">
                    <button @click="showNewProductModal = false" class="px-4 py-2 bg-slate-800 text-slate-300 font-semibold text-xs rounded-xl">Hủy</button>
                    <button @click="saveNewProduct" class="px-5 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl">Tạo & Chọn Nhập</button>
                </div>
            </div>
        </div>

        <!-- MODAL: VIEW IMEI LIST DETAILS -->
        <div v-if="activeImeiModalItem" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-md w-full p-5 space-y-3 shadow-2xl animate-fade">
                <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                    <div>
                        <h3 class="text-xs font-bold text-white">Danh sách IMEI / Serial</h3>
                        <p class="text-[11px] text-slate-400">{{ activeImeiModalItem.name }}</p>
                    </div>
                    <button @click="activeImeiModalItem = null" class="text-slate-500 hover:text-white">✕</button>
                </div>
                <div class="max-h-60 overflow-y-auto space-y-1.5 custom-scrollbar">
                    <div v-for="(code, i) in activeImeiModalItem.imeis" :key="i" class="p-2 bg-slate-950 rounded border border-slate-800 font-mono text-xs text-emerald-400 flex items-center justify-between">
                        <span>#{{ i + 1 }}. {{ code }}</span>
                        <span class="text-[10px] text-slate-500">IMEI Khả dụng</span>
                    </div>
                </div>
                <button @click="activeImeiModalItem = null" class="w-full py-2 bg-slate-800 text-slate-300 text-xs font-bold rounded-xl">Đóng</button>
            </div>
        </div>

        <!-- TOAST NOTIFICATION SYSTEM -->
        <div class="fixed bottom-4 right-4 z-50 space-y-2 pointer-events-none">
            <div v-for="t in toasts" :key="t.id" class="px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-xs font-semibold shadow-2xl animate-fade flex items-center gap-2 pointer-events-auto">
                <span>{{ t.icon }}</span>
                <span>{{ t.message }}</span>
            </div>
        </div>

    </div>

    <!-- VUE 3 LOGIC -->
    <script>
        const { createApp, ref, computed, onMounted } = Vue;

        createApp({
            setup() {
                // Mock Suppliers
                const suppliers = ref([
                    { id: 1, name: 'Apple Việt Nam Official', phone: '0901234567', address: 'Quận 1, TP. Hồ Chí Minh', debt: 15000000 },
                    { id: 2, name: 'Samsung Vietnam Distribution', phone: '0988776655', address: 'KCN Yên Phong, Bắc Ninh', debt: 0 },
                    { id: 3, name: 'Phụ Kiện Số 1 Sài Gòn', phone: '0912334455', address: 'Quận 10, TP. HCM', debt: 4500000 }
                ]);

                // Mock Catalog Products
                const catalogProducts = ref([
                    {
                        id: 101,
                        name: 'iPhone 16 Pro Max 256GB',
                        sku: 'IP16PM-256',
                        type: 'imei_variant',
                        unit: 'Cái',
                        stock: 5,
                        costPrice: 28500000,
                        sellPrice: 31900000,
                        variants: [
                            { id: 1, name: 'Titan Sa Mạc (Desert Titanium)', inputQty: 0 },
                            { id: 2, name: 'Titan Tự Nhiên (Natural)', inputQty: 0 },
                            { id: 3, name: 'Titan Trắng (White)', inputQty: 0 }
                        ]
                    },
                    {
                        id: 102,
                        name: 'Củ Sạc Anker 20W USB-C Nano',
                        sku: 'ANK-20W-NC',
                        type: 'simple',
                        unit: 'Cái',
                        stock: 45,
                        costPrice: 160000,
                        sellPrice: 280000,
                        conversionUnit: 'Hộp (10 cái)',
                        conversionFactor: 10
                    },
                    {
                        id: 103,
                        name: 'Áo Thun Polo Premium Unisex',
                        sku: 'POLO-PREM-2026',
                        type: 'variant',
                        unit: 'Cái',
                        stock: 20,
                        costPrice: 110000,
                        sellPrice: 220000,
                        variants: [
                            { id: 11, name: 'Size M - Màu Đen', inputQty: 1 },
                            { id: 12, name: 'Size L - Màu Trắng', inputQty: 1 },
                            { id: 13, name: 'Size XL - Xanh Navy', inputQty: 0 }
                        ]
                    },
                    {
                        id: 104,
                        name: 'Laptop Dell XPS 15 9530 i7 32GB',
                        sku: 'DELL-XPS15-2026',
                        type: 'imei',
                        unit: 'Chiếc',
                        stock: 2,
                        costPrice: 42000000,
                        sellPrice: 48500000
                    }
                ]);

                // Form States
                const partyType = ref('supplier');
                const selectedSupplierId = ref(1);
                const importDate = ref(new Date().toISOString().slice(0, 10));
                const customerForm = ref({ name: '', phone: '', cccd: '', address: '' });

                const productSearch = ref('');
                const showProductDropdown = ref(false);
                const activeConfigProduct = ref(null);

                // Configuration Panel Form State
                const configForm = ref({
                    costPrice: 0,
                    sellPrice: 0,
                    priceBasis: 'base',
                    quantity: 1,
                    supplierWarrantyVal: 12,
                    supplierWarrantyUnit: 'months',
                    customerWarrantyVal: 12,
                    customerWarrantyUnit: 'months',
                    hasVat: true,
                    selectedVariantId: null,
                    imeiText: '',
                    note: ''
                });

                // Order Items & Billing State
                const orderItems = ref([]);
                const discount = ref(0);
                const extraFee = ref(0);
                const payOldDebt = ref(false);
                const paymentMethod = ref('cash');
                const vatRate = ref(10);

                // Toast & Modal Controls
                const toasts = ref([]);
                const showNewProductModal = ref(false);
                const activeImeiModalItem = ref(null);
                const newProductForm = ref({ name: '', sku: '', unit: 'Cái', type: 'simple' });

                // Computed Active Supplier
                const activeSupplier = computed(() => suppliers.value.find(s => s.id === selectedSupplierId.value));

                // Filter Products by Search Keyword
                const filteredProducts = computed(() => {
                    const kw = productSearch.value.trim().toLowerCase();
                    if (!kw) return catalogProducts.value;
                    return catalogProducts.value.filter(p => 
                        p.name.toLowerCase().includes(kw) || p.sku.toLowerCase().includes(kw)
                    );
                });

                // Select Product For Pre-Add Setup
                const selectProductForConfig = (prod) => {
                    activeConfigProduct.value = JSON.parse(JSON.stringify(prod));
                    configForm.value.costPrice = prod.costPrice || 0;
                    configForm.value.sellPrice = prod.sellPrice || 0;
                    configForm.value.quantity = 1;
                    configForm.value.imeiText = '';
                    if (prod.variants?.length) configForm.value.selectedVariantId = prod.variants[0].id;
                    showProductDropdown.value = false;
                    productSearch.value = prod.name;
                };

                // Trigger Fake Camera Barcode Scanner
                const triggerFakeScan = () => {
                    const randomProduct = catalogProducts.value[Math.floor(Math.random() * catalogProducts.value.length)];
                    selectProductForConfig(randomProduct);
                    notify(`📷 Đã quét mã Barcode SP: ${randomProduct.name}`, '🔍');
                };

                // Simulate Batch IMEI Paste
                const simulateBatchImei = () => {
                    const mockCodes = Array.from({ length: 3 }, () => '358' + Math.floor(1000000000000 + Math.random() * 9000000000000));
                    configForm.value.imeiText = mockCodes.join('\n');
                };

                // Profit Margin Calculation Preview
                const profitMarginPercent = computed(() => {
                    if (!configForm.value.sellPrice) return 0;
                    const profit = configForm.value.sellPrice - configForm.value.costPrice;
                    return (profit / configForm.value.sellPrice) * 100;
                });

                // Commit Configured Product into Active Receipt Order
                const commitItemToOrder = () => {
                    if (!activeConfigProduct.value) return;
                    const prod = activeConfigProduct.value;

                    // Handle IMEIs
                    let imeis = [];
                    if (['imei', 'imei_variant'].includes(prod.type)) {
                        imeis = configForm.value.imeiText.split(/[\n,]+/).map(s => s.trim()).filter(Boolean);
                        if (!imeis.length) {
                            alert('Vui lòng nhập hoặc quét ít nhất 1 mã IMEI/Serial!');
                            return;
                        }
                    }

                    // Handle Variants
                    let variantRows = [];
                    if (prod.type === 'variant') {
                        variantRows = prod.variants.filter(v => v.inputQty > 0);
                        if (!variantRows.length) {
                            alert('Vui lòng chọn số lượng cho ít nhất 1 biến thể!');
                            return;
                        }
                    }

                    const qty = prod.type === 'simple' ? configForm.value.quantity 
                              : (imeis.length || variantRows.reduce((s, r) => s + r.inputQty, 0));

                    orderItems.value.push({
                        id: Date.now() + Math.random(),
                        productId: prod.id,
                        name: prod.name,
                        sku: prod.sku,
                        unit: prod.unit,
                        quantity: qty,
                        costPrice: configForm.value.costPrice,
                        sellPrice: configForm.value.sellPrice,
                        supplierWarrantyVal: configForm.value.supplierWarrantyVal,
                        customerWarrantyVal: configForm.value.customerWarrantyVal,
                        hasVat: configForm.value.hasVat,
                        imeis: imeis,
                        variantRows: variantRows,
                        note: configForm.value.note
                    });

                    notify(`Đã thêm "${prod.name}" vào phiếu nhập`, '✅');
                    productSearch.value = '';
                    activeConfigProduct.value = null;
                };

                const removeOrderItem = (idx) => {
                    orderItems.value.splice(idx, 1);
                    notify('Đã xóa mặt hàng khỏi phiếu', '🗑️');
                };

                const clearOrder = () => {
                    orderItems.value = [];
                    notify('Đã xóa toàn bộ phiếu nhập', '🧹');
                };

                // Calculations
                const totalQuantityCount = computed(() => orderItems.value.reduce((sum, item) => sum + item.quantity, 0));
                
                const subTotalCost = computed(() => orderItems.value.reduce((sum, item) => sum + (item.costPrice * item.quantity), 0));

                const totalVatEstimate = computed(() => {
                    return orderItems.value.reduce((sum, item) => {
                        if (!item.hasVat) return sum;
                        return sum + Math.round((item.costPrice * item.quantity) * (vatRate.value / 100));
                    }, 0);
                });

                const grandTotal = computed(() => {
                    let total = subTotalCost.value + totalVatEstimate.value - discount.value + extraFee.value;
                    if (payOldDebt.value && activeSupplier.value) total += activeSupplier.value.debt;
                    return Math.max(0, total);
                });

                // Save Quick New Product
                const saveNewProduct = () => {
                    if (!newProductForm.value.name) return;
                    const created = {
                        id: Date.now(),
                        name: newProductForm.value.name,
                        sku: newProductForm.value.sku || ('SKU-' + Math.floor(1000 + Math.random() * 9000)),
                        unit: newProductForm.value.unit || 'Cái',
                        type: newProductForm.value.type,
                        stock: 0,
                        costPrice: 0,
                        sellPrice: 0,
                        variants: newProductForm.value.type.includes('variant') ? [{ id: 1, name: 'Mặc định', inputQty: 1 }] : []
                    };
                    catalogProducts.value.unshift(created);
                    selectProductForConfig(created);
                    showNewProductModal.value = false;
                    notify(`Đã tạo sản phẩm mới: ${created.name}`, '🎉');
                };

                const openImeiDetailModal = (item) => {
                    activeImeiModalItem.value = item;
                };

                const completeOrder = () => {
                    if (!orderItems.value.length) return;
                    alert(`✅ ĐÃ LƯU THÀNH CÔNG PHIẾU NHẬP HÀNG!\n- Tổng tiền: ${formatMoney(grandTotal.value)}\n- Số lượng nhập: ${totalQuantityCount.value} món\n- Phương thức: ${paymentMethod.value.toUpperCase()}`);
                    resetForm();
                };

                const resetForm = () => {
                    orderItems.value = [];
                    discount.value = 0;
                    extraFee.value = 0;
                    payOldDebt.value = false;
                    activeConfigProduct.value = null;
                    notify('Đã làm mới form nhập hàng', '✨');
                };

                const notify = (message, icon = '🔔') => {
                    const id = Date.now();
                    toasts.value.push({ id, message, icon });
                    setTimeout(() => {
                        toasts.value = toasts.value.filter(t => t.id !== id);
                    }, 3000);
                };

                const formatMoney = (val) => new Intl.NumberFormat('vi-VN').format(val || 0) + ' ₫';

                const getTypeBadgeClass = (type) => ({
                    simple: 'bg-blue-500/20 text-blue-400 border border-blue-500/30',
                    variant: 'bg-purple-500/20 text-purple-400 border border-purple-500/30',
                    imei: 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30',
                    imei_variant: 'bg-amber-500/20 text-amber-400 border border-amber-500/30',
                })[type] || 'bg-slate-800 text-slate-300';

                const getTypeLabel = (type) => ({
                    simple: 'Thường',
                    variant: 'Biến thể',
                    imei: 'IMEI/Serial',
                    imei_variant: 'IMEI + Biến thể',
                })[type] || type;

                // Auto select first catalog item for easy demo
                onMounted(() => {
                    selectProductForConfig(catalogProducts.value[0]);
                });

                return {
                    suppliers,
                    catalogProducts,
                    partyType,
                    selectedSupplierId,
                    activeSupplier,
                    importDate,
                    customerForm,
                    productSearch,
                    showProductDropdown,
                    filteredProducts,
                    activeConfigProduct,
                    configForm,
                    orderItems,
                    discount,
                    extraFee,
                    payOldDebt,
                    paymentMethod,
                    vatRate,
                    toasts,
                    showNewProductModal,
                    newProductForm,
                    activeImeiModalItem,
                    selectProductForConfig,
                    triggerFakeScan,
                    simulateBatchImei,
                    profitMarginPercent,
                    commitItemToOrder,
                    removeOrderItem,
                    clearOrder,
                    totalQuantityCount,
                    subTotalCost,
                    totalVatEstimate,
                    grandTotal,
                    saveNewProduct,
                    openImeiDetailModal,
                    completeOrder,
                    resetForm,
                    formatMoney,
                    getTypeBadgeClass,
                    getTypeLabel
                };
            }
        }).mount('#app');
    </script>
</body>
</html>